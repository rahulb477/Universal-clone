# Universal Clone 3.1 — configuration reference.
# Copy to `.env` for local use. In production set these in the platform's secret manager instead.
# Variables marked [web] are read by the Next.js app, [worker] by `npm run worker`, [both] by both.
# In single-server ("inline") mode one process plays both roles, so set everything there.
# Full explanations: docs/DEPLOYMENT.md

# ───────────── Required ─────────────
# [both] PostgreSQL. Web and worker must point at the SAME database. `npm run db:dev` prints a local one.
DATABASE_URL=postgres://postgres:dev-only-password@127.0.0.1:54321/universal_clone
# [both] "require" = TLS with certificate verification, "no-verify" = TLS without verification, unset = no TLS.
#DATABASE_SSL=require
#DATABASE_POOL_MAX=10

# [both] 32 random bytes (base64 or 64 hex chars): `openssl rand -base64 32`.
# Encrypts site credentials and saved browser sessions at rest. Without it signed-in crawling is disabled.
# Web and worker need the SAME value. Changing it makes unfinished signed-in crawls unresumable.
CRAWLER_CREDENTIAL_ENCRYPTION_KEY=

# ───────────── Where crawls run ─────────────
# [web] inline   = this server also runs crawls (needs Chromium and a persistent process).
#       external = a separate `npm run worker` process runs them (required on Vercel/serverless).
# Default: external when VERCEL is set, otherwise inline.
#CRAWLER_WORKER_MODE=inline

# ───────────── Accounts ─────────────
# [web] closed (default: accounts only via `npm run user:create`), invite, or open.
#AUTH_REGISTRATION=closed
# [web] Needed for AUTH_REGISTRATION=invite; at least 16 characters.
#AUTH_INVITE_CODE=
#AUTH_SESSION_TTL_HOURS=168
# [web] Session cookie is Secure + __Host- prefixed in production. Set 0 ONLY for plain-http local testing.
#AUTH_COOKIE_SECURE=1
# [web] One-time first-administrator setup at /setup-admin. A random secret of AT LEAST 32 characters
# (`openssl rand -base64 48`). Missing or weaker = setup disabled. Remove it after the first admin exists.
# Browser setup without a terminal: docs/ADMIN-SETUP.md
#ADMIN_SETUP_KEY=
# [web] Comma-separated origins allowed to send state-changing requests. Unset = the request's own origin.
#APP_ORIGIN=https://clone.example.com
# [web] Number of reverse proxies in front of the app whose X-Forwarded-For entry can be trusted (0 = none).
#TRUSTED_PROXY_HOPS=1
# [web] Leave unset in production. Origins allowed to show the app inside an <iframe>
# (space/comma separated, or * for a throw-away demo). Weakens click-jacking protection.
#APP_EMBED_ORIGINS=

# ───────────── Archive storage ─────────────
# [both] local (default) or s3. Defaults to s3 when S3_BUCKET is set.
# Use s3 whenever web and worker do not share a disk (always the case on Vercel).
#ARCHIVE_STORAGE=s3
#S3_BUCKET=
#S3_ACCESS_KEY_ID=
#S3_SECRET_ACCESS_KEY=
#S3_REGION=us-east-1
# Non-AWS services (Cloudflare R2, MinIO, Backblaze B2 …): the service's S3 endpoint.
#S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# 1 = https://endpoint/bucket/key, 0 = https://bucket.endpoint/key. Default: 1 when S3_ENDPOINT is set.
#S3_FORCE_PATH_STYLE=1
# [web] Lifetime of a download link in seconds (1–3600).
#DOWNLOAD_URL_TTL_SECONDS=60
# [both] Local storage root (default: CRAWL_DATA_DIR/_store).
#ARCHIVE_DIR=

# ───────────── Worker ─────────────
# [worker] Scratch space for running crawls (default ./.crawl-data). Needs room for the largest crawl.
#CRAWL_DATA_DIR=/var/lib/universal-clone
# [worker] Stable name shown in the workers table (default: host-pid-random).
#WORKER_ID=worker-1
# [worker] 1 = apply pending database migrations at start.
#WORKER_MIGRATE=1
# [worker] Serve GET /healthz on this port for the process supervisor.
#WORKER_HEALTH_PORT=8080
#WORKER_HEALTH_HOST=0.0.0.0
# [worker] A crawl whose worker has not sent a heartbeat for this long is marked "interrupted" (min 15).
#WORKER_STALE_SECONDS=45
# [worker] 1 = start even without Chromium (only "fast" HTTP-only crawls will work).
#WORKER_ALLOW_NO_BROWSER=0
# [worker] Path to a Chromium/Chrome binary. Default: Playwright's browser, else the npm-packaged build.
#CHROMIUM_PATH=/usr/bin/chromium
# [worker] 1 = run Chromium with its sandbox (needs unprivileged user namespaces; off by default for containers).
#CRAWLER_CHROMIUM_SANDBOX=1

# ───────────── Limits ─────────────
#CRAWLER_MAX_CONCURRENT_JOBS=5          # [worker] crawls one worker runs at once
#CRAWLER_MAX_ACTIVE_JOBS_PER_USER=5     # [web]
#CRAWLER_STARTS_PER_MINUTE=5            # [web] per user
#CRAWLER_STORAGE_QUOTA_BYTES=5368709120 # [web] per user, stored ZIP bytes
#CRAWL_RETENTION_HOURS=24               # [worker] ended crawls and their archives are deleted this long after creation
#CRAWLER_SESSION_TTL_HOURS=12           # [worker] saved site sessions
#CRAWLER_INTERACTIVE_LOGIN_MINUTES=10   # [worker] how long a manual sign-in window stays open (max 60)
#CRAWLER_AUTH_MAX_PROFILES=5            # [both] login profiles per crawl (1–5)
#CRAWLER_HARD_MAX_PAGES=5000            # [both] ceiling for the per-crawl page limit
#CRAWLER_HARD_MAX_TOTAL_BYTES=2147483648
#SSE_MAX_SECONDS=280                    # [web] live-update stream length before the browser reconnects

# ───────────── Operator-only switch ─────────────
# [both] 1 = allow crawling private/loopback addresses (intranet installs, tests). Never set on a public service.
# Every worker attached to one database must use the same value.
#CRAWLER_ALLOW_PRIVATE_NETWORKS=0
